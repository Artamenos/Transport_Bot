<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="true"
    app:strokeColor="#E7E7E7"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        tools:ignore="MissingContentDescription">

        <ImageView
            android:id="@+id/imageRoute"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="#EEF4FF"
            android:contentDescription="@string/route_image_description"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_directions"
            tools:ignore="ContentDescription"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textRouteNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageRoute"
            app:layout_constraintTop_toTopOf="@id/imageRoute" />

        <TextView
            android:id="@+id/textRouteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textRouteNumber"
            app:layout_constraintTop_toBottomOf="@id/textRouteNumber" />

        <TextView
            android:id="@+id/textRouteRoute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textRouteTitle"
            app:layout_constraintTop_toBottomOf="@id/textRouteTitle" />

        <TextView
            android:id="@+id/textRouteDateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#555555"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textRouteRoute"
            app:layout_constraintTop_toBottomOf="@id/textRouteRoute" />

        <TextView
            android:id="@+id/textRouteType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#555555"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textRouteDateTime"
            app:layout_constraintTop_toBottomOf="@id/textRouteDateTime" />

        <TextView
            android:id="@+id/textRouteCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#6A1B9A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textRouteType"
            app:layout_constraintTop_toBottomOf="@id/textRouteType" />

        <TextView
            android:id="@+id/textRouteStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#2E7D32"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textRouteCode"
            app:layout_constraintTop_toBottomOf="@id/textRouteCode" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRouteDetails"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Подробнее"
            app:layout_constraintStart_toStartOf="@id/textRouteType"
            app:layout_constraintTop_toBottomOf="@id/textRouteStatus"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
